# Copy this file to a new file named .env (same folder) and remove the # in front of a line to use it.

# If Tesseract OCR is installed in a different place:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Use PostgreSQL instead of SQLite (after: pip install -r requirements-postgres.txt):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ipam_docs

# Force the search engine: auto (default), sbert, or lsa
# EMBEDDING_BACKEND=auto
